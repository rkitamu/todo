#!/usr/bin/env bash
# 次に振る TODO の id を 1 つ表示する。
#   todo-next-id            このリポジトリの data/ を見る
#   todo-next-id <data_dir> 別の data ディレクトリを見る（demo/ など）
# 新しい id = (active.md・archive.md・notes/ に現れる最大の id) + 1。id は再利用しない。
# 表示するだけで、どこにも書き込まない（同時に 2 件足すときは、2 件目は +1 して使う）。
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
DATA="${1:-$REPO/data}"

[[ -d "$DATA" ]] || { echo "error: $DATA がありません" >&2; exit 1; }

{
  # active.md: | id | status | ... → 1 列目
  [[ -f "$DATA/active.md" ]] && awk -F'|' '/^\|/ { gsub(/ /, "", $2); if ($2 ~ /^[0-9]+$/) print $2 }' "$DATA/active.md"
  # archive.md: - [x] <id> <name> → 3 語目
  [[ -f "$DATA/archive.md" ]] && awk '/^- \[.\] [0-9]+ / { print $3 }' "$DATA/archive.md"
  # notes/<id>-<slug>.md
  if [[ -d "$DATA/notes" ]]; then
    find "$DATA/notes" -maxdepth 1 -name '*.md' -exec basename {} \; | sed -n 's/^\([0-9][0-9]*\)-.*/\1/p'
  fi
  echo 0
} | sort -n | tail -1 | awk '{ print $1 + 1 }'
